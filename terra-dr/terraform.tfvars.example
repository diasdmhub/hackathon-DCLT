# Copie este arquivo para "terraform.tfvars" e ajuste os valores abaixo.
# Ver terra-dr/README.md para o runbook completo de ativação.

name_prefix = "solidarytech" # IGUAL ao do ambiente ativo (terra/) - ver comentário em variables.tf
aws_region  = "us-west-2"    # Região do ambiente passivo - IGUAL a dr_aws_region em terra/terraform.tfvars

# CIDR da VPC (2 primeiros octetos) - distinto do ambiente ativo (10.80)
subnet_prefix = "10.90"
az_count      = 2

# EKS
eks_node_instance_types  = ["m7i-flex.large"]
eks_node_desired_size    = 2
eks_node_min_size        = 1
eks_node_max_size        = 4
enable_prefix_delegation = true

# RDS - Credenciais do DB. db_password precisa ser IGUAL à senha real do
# ambiente ativo (só compõe a URL de conexão; a senha efetiva vem do
# restore - ver variables.tf).
db_name     = "sol_db"
db_username = "sol"
db_password = "CHANGE_ME"

rds_instance_class          = "db.t3.micro"
rds_backup_retention_period = 7

# Deixe null (comentado) até a ativação real - ver terra-dr/README.md para
# como descobrir o ARN do backup replicado mais recente.
# rds_restore_source_arn = "arn:aws:rds:us-west-2:123456789012:auto-backup:ab-..."

# DynamoDB / SQS
dynamodb_table_name = "SolidaryTechVolunteers" # IGUAL ao ambiente ativo - é a mesma tabela (réplica), não uma nova
sqs_queue_name       = "donation-events"

# IAM/IRSA
k8s_namespace              = "solidarytech"
donation_service_account   = "donation-service"
volunteer_service_account  = "volunteer-service"

lb_controller_namespace       = "kube-system"
lb_controller_service_account = "aws-load-balancer-controller"

# FluxCD - versão do chart Helm flux2 (../terra/modules/flux)
flux_chart_version = "2.19.0"

# NLB - mesmas regras de terra/terraform.tfvars (ver lá para os exemplos de
# formato aceito: CIDR, IP solto ou domínio)
observe_allowed_cidrs = ["CHANGE_ME"]

# Grafana Private Datasource Connect (PDC) - grafana_pdc_token precisa ser
# IGUAL ao valor real usado em terra/terraform.tfvars (mesma network).
# Opcional: vazio (default) mantém o módulo desativado.
# grafana_pdc_token   = ""
# grafana_pdc_cluster = ""

# Failover DNS (Route53) - copie route53_zone_id do output route53_zone_id
# de terra/ (só existe quando manage_dns = true por lá); dns_record_name
# precisa ser IGUAL ao usado em terra/terraform.tfvars.
route53_zone_id = "CHANGE_ME"
dns_record_name = "CHANGE_ME" # ex.: "api.solidarytech.diasdm.com.br"
