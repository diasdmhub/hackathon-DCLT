# ---------- Build ----------
# Base Slim para compilação completa da imagem e com tamanho razoável
FROM docker.io/library/python:3-alpine
WORKDIR /usr/src/ngo

# Copia somente os requisitos para o cache desta camada
COPY ./ngo-service/requirements.txt ./

# Instala as dependências
RUN pip install --no-cache-dir -r requirements.txt

# Gera e instala os pacotes de auto-instrumentação para as bibliotecas
RUN pip install --no-cache-dir opentelemetry-instrumentation || true

# Copia o script principal
COPY ./ngo-service/app.py ./ngo.py

# ----------- Run -----------
EXPOSE 8081

CMD [ "opentelemetry-instrument", "gunicorn", "--bind", "0.0.0.0:8081", "ngo:app" ]