# Porta em que o Volunteer service recebe requisições
PORT="8083"

# Região da AWS
AWS_REGION="us-east-1"

# Nome da tabela no DynamoDB
AWS_DYNAMODB_TABLE="SolidaryTechVolunteers"

# Endpoint personalizado do SDK que aponta para o DynamoDB Local em vez da AWS real.
# Remova esta variável para voltar a usar a AWS real.
AWS_ENDPOINT_URL="http://dynamodb:8000"

# Credenciais falsas exigidas pelo SDK para assinar requisições - o DynamoDB Local não as valida
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"