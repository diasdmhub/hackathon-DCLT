# ---------- Build ----------
# Base Slim para compilação completa da imagem e com tamanho razoável
FROM docker.io/library/python:3-alpine
WORKDIR /usr/src/ngo

# Copia somente os requisitos para o cache desta camada
COPY ./ngo-service/requirements.txt ./

# Instala as dependências, incluindo o distro e as instrumentações OpenTelemetry
RUN pip install --no-cache-dir -r requirements.txt

# Copia o script principal
COPY ./ngo-service/app.py ./ngo.py

# ----------- Run -----------
EXPOSE 8081

CMD [ "opentelemetry-instrument", "gunicorn", "--bind", "0.0.0.0:8081", "--worker-class", "gthread", "--threads", "4", "ngo:app" ]