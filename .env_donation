# Porta em que o Donation service recebe requisições
PORT="8082"

# URL authenticada do DB
DATABASE_URL="postgres://sol:sol@psql:5432/sol_db"

# Região da AWS
AWS_REGION="us-east-1"

# URL da AWS para a fila SQS
# AWS_SQS_URL="https://sqs.us-east-1.amazonaws.com/123456789012/fiap-hackathon"

# URL da fila ElasticMQ que roda localmente
AWS_SQS_URL="http://elasticmq:9324/queue/fiap-hackathon"

# Endpoint personalizado do SDK. Aponta para o ElasticMQ em vez da AWS real.
# Remova esta variável para voltar a usar a AWS real.
AWS_ENDPOINT_URL="http://elasticmq:9324"

# Credenciais falsas exigidas pelo SDK para assinar requisições - o ElasticMQ não as valida
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"