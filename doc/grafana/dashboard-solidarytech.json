    {
      "id": 5, "type": "stat", "title": "Erros HTTP 4xx/5xx (período)",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "loki", "uid": "aftoyrqjz77cwb" },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 10 }
          ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [
        {
          "refId": "A", "datasource": { "type": "loki", "uid": "aftoyrqjz77cwb" },
          "expr": "sum(count_over_time({namespace=\"solidarytech\"} |~ \"-> [45]\\\\d\\\\d\" [$__range]))",
          "queryType": "instant", "instant": true, "range": false
        }
      ]
    },
    {
      "id": 6, "type": "stat", "title": "Latência p95 — donation-service (Hot Path)",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "bfts7wbtgac5cf" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.5 },
            { "color": "red", "value": 1.5 }
          ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [
        {
          "refId": "A", "datasource": { "type": "prometheus", "uid": "bfts7wbtgac5cf" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=\"donation-service\"}[$__rate_interval])))",
          "instant": true
        }
      ]
    },

    { "id": 101, "type": "row", "title": "Service Map (Tempo + Prometheus)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "collapsed": false, "panels": [] },

    {
      "id": 10, "type": "nodeGraph", "title": "Mapa de serviços — SolidaryTech",
      "description": "Derivado pelo metrics-generator do Tempo (service-graphs) a partir das traces recebidas; requer o datasource Prometheus configurado em Tempo → Service Graph.",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "tempo", "uid": "cfts5iiz9ff9cd" },
      "targets": [
        { "refId": "A", "datasource": { "type": "tempo", "uid": "cfts5iiz9ff9cd" }, "queryType": "serviceMap" }
      ]
    },

    { "id": 102, "type": "row", "title": "RED por serviço (Prometheus / metrics-generator)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 }, "collapsed": false, "panels": [] },

    {
      "id": 20, "type": "timeseries", "title": "Taxa de requisições por serviço",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "bfts7wbtgac5cf" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A", "datasource": { "type": "prometheus", "uid": "bfts7wbtgac5cf" },
          "expr": "sum by (service) (rate(traces_spanmetrics_calls_total[$__rate_interval]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 21, "type": "timeseries", "title": "Taxa de erro por serviço (%)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "bfts7wbtgac5cf" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A", "datasource": { "type": "prometheus", "uid": "bfts7wbtgac5cf" },
          "expr": "100 * sum by (service) (rate(traces_spanmetrics_calls_total{status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) / sum by (service) (rate(traces_spanmetrics_calls_total[$__rate_interval]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 22, "type": "timeseries", "title": "Latência p50/p95/p99 por serviço",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "bfts7wbtgac5cf" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 0 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A", "datasource": { "type": "prometheus", "uid": "bfts7wbtgac5cf" },
          "expr": "histogram_quantile(0.50, sum by (service, le) (rate(traces_spanmetrics_latency_bucket[$__rate_interval])))",
          "legendFormat": "{{service}} p50"
        },
        {
          "refId": "B", "datasource": { "type": "prometheus", "uid": "bfts7wbtgac5cf" },
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(traces_spanmetrics_latency_bucket[$__rate_interval])))",
          "legendFormat": "{{service}} p95"
        },
        {
          "refId": "C", "datasource": { "type": "prometheus", "uid": "bfts7wbtgac5cf" },
          "expr": "histogram_quantile(0.99, sum by (service, le) (rate(traces_spanmetrics_latency_bucket[$__rate_interval])))",
          "legendFormat": "{{service}} p99"
        }
      ]
    },

