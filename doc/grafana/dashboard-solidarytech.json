  "panels": [
    { "id": 100, "type": "row", "title": "Visão geral", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false, "panels": [] },

    {
      "id": 1, "type": "stat", "title": "Doações (período)",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "loki", "uid": "aftoyrqjz77cwb" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [
        {
          "refId": "A", "datasource": { "type": "loki", "uid": "aftoyrqjz77cwb" },
          "expr": "sum(count_over_time({namespace=\"solidarytech\", container=\"donation\"} |~ \"POST /donations -> 201\" [$__range]))",
          "queryType": "instant", "instant": true, "range": false
        }
      ]
    },
    {
      "id": 2, "type": "stat", "title": "Valor arrecadado (período)",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "loki", "uid": "aftoyrqjz77cwb" },
      "fieldConfig": { "defaults": { "unit": "currencyBRL", "decimals": 2 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [
        {
          "refId": "A", "datasource": { "type": "loki", "uid": "aftoyrqjz77cwb" },
          "expr": "sum(sum_over_time({namespace=\"solidarytech\", container=\"donation\"} |~ \"POST /donations -> 201\" | regexp \"valor=(?P<valor>[0-9]+\\\\.[0-9]+)\" | unwrap valor [$__range]))",
          "queryType": "instant", "instant": true, "range": false
        }
      ]
    },
    {
      "id": 3, "type": "stat", "title": "ONGs cadastradas (período)",
