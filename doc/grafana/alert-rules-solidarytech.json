{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "solidarytech-alerts",
      "folder": "SolidaryTech",
      "interval": "1m",
      "rules": [
        {
          "uid": "solidarytech-donation-error-rate",
          "title": "Donation Service - taxa de erro acima da meta de SLO",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": { "from": 600, "to": 0 },
              "datasourceUid": "bfts7wbtgac5cf",
              "model": {
                "refId": "A",
                "range": true,
                "instant": false,
                "expr": "100 * sum(rate(traces_spanmetrics_calls_total{service=\"donation-service\", status_code=\"STATUS_CODE_ERROR\"}[5m])) / sum(rate(traces_spanmetrics_calls_total{service=\"donation-service\"}[5m]))"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": { "from": 600, "to": 0 },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "expression": "A",
                "reducer": "last"
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": { "from": 600, "to": 0 },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": { "type": "gt", "params": [5] },
                    "operator": { "type": "and" },
                    "query": { "params": ["B"] },
                    "reducer": { "type": "last", "params": [] },
                    "type": "query"
                  }
                ]
              }
            }
          ],
          "noDataState": "NoData",
          "execErrState": "Error",
          "for": "5m",
          "annotations": {
            "summary": "donation-service acima de 5% de erro em 5m",
            "description": "A meta de SLO (dashboard Golden Metrics, aba Donation SLO) é 95% das requisições sem erro. Taxa de erro atual: {{ $values.B }}%."
          },
          "labels": {
            "severity": "critical",
            "service": "donation-service"
          },
          "notification_settings": {
            "receiver": "Zabbix"
          }
        },
        {
          "uid": "solidarytech-pods-unavailable",
          "title": "SolidaryTech - pods indisponiveis abaixo do esperado",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": { "from": 300, "to": 0 },
              "datasourceUid": "bfts7wbtgac5cf",
              "model": {
                "refId": "A",
                "range": true,
                "instant": false,
                "expr": "kube_deployment_spec_replicas{namespace=\"solidarytech\"} - kube_deployment_status_replicas_available{namespace=\"solidarytech\"}"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": { "from": 300, "to": 0 },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "expression": "A",
                "reducer": "last"
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": { "from": 300, "to": 0 },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": { "type": "gt", "params": [0] },
                    "operator": { "type": "and" },
                    "query": { "params": ["B"] },
                    "reducer": { "type": "last", "params": [] },
                    "type": "query"
                  }
                ]
              }
            }
          ],
          "noDataState": "NoData",
          "execErrState": "Error",
          "for": "5m",
          "annotations": {
            "summary": "Deployment com menos replicas disponiveis do que o especificado",
            "description": "Diferenca entre replicas especificadas e disponiveis (por deployment) sustentada ha 5 minutos. Verificar rollout, crash loop ou falha de readiness probe."
          },
          "labels": {
            "severity": "warning"
          },
          "notification_settings": {
            "receiver": "Zabbix"
          }
        },
        {
          "uid": "solidarytech-donation-silence",
          "title": "Donation Service - sem trafego no Hot Path",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": { "from": 1800, "to": 0 },
              "datasourceUid": "bfts7wbtgac5cf",
              "model": {
                "refId": "A",
                "range": true,
                "instant": false,
                "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"donation-service\"}[15m]))"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": { "from": 1800, "to": 0 },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "expression": "A",
                "reducer": "last"
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": { "from": 1800, "to": 0 },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": { "type": "lte", "params": [0] },
                    "operator": { "type": "and" },
                    "query": { "params": ["B"] },
                    "reducer": { "type": "last", "params": [] },
                    "type": "query"
                  }
                ]
              }
            }
          ],
          "noDataState": "NoData",
          "execErrState": "Error",
          "for": "30m",
          "annotations": {
            "summary": "Nenhuma chamada ao donation-service nos ultimos 15 minutos",
            "description": "RED e saude de pods podem estar normais mesmo com o fluxo de doacoes parado (ex.: falha silenciosa na publicacao SQS, problema de roteamento no NLB/Ingress antes do servico). Considerar Mute Timing para horarios sem uso esperado."
          },
          "labels": {
            "severity": "warning",
            "service": "donation-service"
          },
          "notification_settings": {
            "receiver": "Zabbix"
          }
        }
      ]
    }
  ]
}
