{
    "apiVersion": 1,
    "contactPoints": [
        {
            "orgId": 1,
            "name": "Zabbix",
            "receivers": [
                {
                    "uid": "",
                    "type": "webhook",
                    "settings": {
                        "url": "<ZABBIX_API_URL>",
                        "httpMethod": "POST",
                        "authorization_scheme": "Bearer",
                        "authorization_credentials": "<ZABBIX_API_TOKEN>",
                        "headers": {
                            "Content-Type": "application/json-rpc"
                        },
                        "payload": {
                            "template": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"history.push\",\n  \"params\": [\n    {\"itemid\": {{.Vars.zabbix_itemid}}, \"value\": \"{{ .CommonLabels.alertname }}: {{ .Status }}\"}\n  ],\n  \"id\": 1\n}",
                            "vars": {
                                "zabbix_itemid": "<ZABBIX_ITEM_ID>"
                            }
                        }
                    },
                    "disableResolveMessage": false
                }
            ]
        }
    ]
}
