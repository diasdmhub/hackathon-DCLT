# Copie este arquivo para "terraform.tfvars" e ajuste os valores abaixo.

name_prefix = "solidarytech"  # Prefixo geral para os recursos da SolidaryTech
aws_region  = "us-east-1"     # Região principal da AWS

# CIDR da VPC (2 primeiros octetos)
subnet_prefix = "10.80"
az_count      = 2

# EKS - m7i-flex.large é elegível ao free tier baseado em créditos em contas
# criadas a partir de 15/07/2025 (até US$200/6 meses); troque para
# t3.micro/t3.small se a conta for mais antiga (free tier de 750h/mês).
eks_node_instance_types     = ["m7i-flex.large"]
eks_node_desired_size       = 2
eks_node_min_size           = 1
eks_node_max_size           = 4
eks_enable_prefix_delegation = true

# RDS - CREDENCIAL SENSÍVEL, defina um valor real aqui
db_name     = "sol_db"
db_username = "sol"
db_password = "CHANGE_ME"

rds_instance_class = "db.t3.micro"

# DynamoDB / SQS - mantidos com os nomes já usados hoje pelos serviços
dynamodb_table_name = "SolidaryTechVolunteers"
sqs_queue_name       = "donation-events"

# IAM/IRSA - namespace e ServiceAccounts que os pods deverão usar em kube/
k8s_namespace              = "solidarytech"
donation_service_account   = "donation-service"
volunteer_service_account  = "volunteer-service"

# IAM/IRSA - ServiceAccount do AWS Load Balancer Controller (lb-controller/)
lb_controller_namespace       = "kube-system"
lb_controller_service_account = "aws-load-balancer-controller"

# NLB - CIDR(s), IP(s) ou domínio(s) autorizados a alcançar
# Loki/Tempo/Prometheus (observe-aws/). Esses backends não têm autenticação
# própria, então NÃO use 0.0.0.0/0 aqui: restrinja ao IP público de onde o
# seu Grafana externo consulta. Aceita um CIDR ("203.0.113.10/32"), um IP
# solto ("203.0.113.10", vira /32) ou um domínio ("meudominio.com.br", ex.:
# um DDNS que aponta para seu IP dinâmico - resolvido via DNS a cada
# terraform apply, ver terra/dns.tf).
observe_allowed_cidrs = ["CHANGE_ME"]

# Zabbix (terra/modules/zabbix) - identificam sua infraestrutura pessoal,
# por isso sem default. zabbix_hostname precisa bater com o nome do objeto
# "Proxy" criado manualmente no seu Zabbix server (Data collection ->
# Proxies, modo Active); zabbix_server_host é o hostname/IP desse servidor
# (porta 10051) - ver terra/modules/zabbix/README.md.
zabbix_hostname    = "CHANGE_ME-solidarytech-eks-proxy"
zabbix_server_host = "CHANGE_ME"

# Versão major.minor das imagens Docker do Zabbix Proxy/Agent2 (monta a tag
# "ol-<versão>-latest"). Tem default ("7.4") em variables.tf, só precisa
# repetir aqui se quiser fixar outra versão - confira que bate com a versão
# do seu Zabbix server externo.
zabbix_version = "7.4"
