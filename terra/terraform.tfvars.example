# Copie este arquivo para "terraform.tfvars" e ajuste os valores abaixo.

name_prefix = "solidarytech"  # Prefixo geral para os recursos da SolidaryTech
aws_region  = "us-east-1"     # Região principal da AWS

# CIDR da VPC (2 primeiros octetos)
subnet_prefix = "10.80"
az_count      = 2

# EKS - m7i-flex.large é elegível ao free tier baseado em créditos em contas
# criadas a partir de 15/07/2025 (até US$200/6 meses); troque para
# t3.micro/t3.small se a conta for mais antiga (free tier de 750h/mês).
eks_node_instance_types     = ["m7i-flex.large"]
eks_node_desired_size       = 2
eks_node_min_size           = 1
eks_node_max_size           = 4
enable_prefix_delegation    = true

# RDS - Credenciais do DB
db_name     = "sol_db"
db_username = "sol"
db_password = "CHANGE_ME"

rds_instance_class = "db.t3.micro"

# DynamoDB / SQS
dynamodb_table_name = "SolidaryTechVolunteers"
sqs_queue_name      = "donation-events"

# IAM/IRSA - namespace e ServiceAccounts que os pods deverão usar
k8s_namespace              = "solidarytech"
donation_service_account   = "donation-service"
volunteer_service_account  = "volunteer-service"

# IAM/IRSA - ServiceAccount do AWS Load Balancer Controller
lb_controller_namespace       = "kube-system"
lb_controller_service_account = "aws-load-balancer-controller"

# FluxCD - versão do chart Helm flux2 (terra/modules/flux)
flux_chart_version = "2.19.0"

# NLB - CIDR(s), IP(s) ou domínio(s) autorizados a alcançar
# Loki/Tempo/Prometheus (observe-aws/). Esses backends não têm autenticação
# própria, então NÃO use 0.0.0.0/0. Restrinja ao IP público de onde o
# Grafana externo consulta.
# Exemplos:
#    CIDR "203.0.113.10/32"
#    IP "203.0.113.10" (vira /32)
#    Nome de domínio "meudominio.com.br" (resolvido via DNS a cada
#                                        terraform apply, ver terra/dns.tf)
observe_allowed_cidrs = ["CHANGE_ME"]

# Grafana Cloud - remote_write de saída do Prometheus (só as séries de
# golden metrics/SLI, ver terra/modules/prometheus/prometheus.yml.tpl),
# para o histórico de SLO sobreviver a uma migração para terra-dr/. Deixe os
# 3 valores em branco ("") para manter o remote_write desativado.
grafana_cloud_remote_write_url = "CHANGE_ME" # ex.: https://prometheus-prod-NN-prod-REGIAO.grafana.net/api/prom/push
grafana_cloud_username         = "CHANGE_ME" # Instance ID do stack Grafana Cloud
grafana_cloud_api_key          = "CHANGE_ME" # API key com permissão de escrita (MetricsPublisher)

# Disaster Recovery (ambiente ativo-passivo) - ver "Disaster Recovery" em
# terra/README.md e o runbook em terra-dr/README.md. enable_dr/manage_dns
# ligados por padrão aqui: a camada de proteção contínua de dados
# (replicação de backup do RDS + Global Table do DynamoDB) e o Route53
# (zone + registro PRIMARY) são baratos e não sobem nenhum compute extra.
# terra-dr/ (o ambiente passivo em si - VPC/EKS/RDS restaurado/NLB/
# observabilidade) continua uma ação separada e sob demanda, só na ativação
# de um desastre real ou simulado - não é ligado por enable_dr aqui.
enable_dr = true

dr_aws_region               = "us-west-2"
rds_backup_retention_period = 7
manage_dns                  = true
dns_zone_name               = "CHANGE_ME" # ex.: "solidarytech.meu.dominio"
dns_record_name             = "CHANGE_ME" # ex.: "api.solidarytech.meu.dominio"
