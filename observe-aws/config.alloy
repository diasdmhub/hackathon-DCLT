# Variante do observe/020-alloy/config.alloy para o ambiente AWS: mesma
# coleta de logs (tail dos arquivos CRI) e o mesmo ponto de entrada OTLP
# para traces dos 3 microserviços, mas exportando para o Grafana Cloud em
# vez do Loki/Tempo locais - não há Loki, Tempo nem Prometheus neste
# ambiente (ver observe-aws/kustomization.yaml e README.md).
#
# Credenciais e URLs de endpoint vêm de variáveis de ambiente injetadas via
# Secret "grafana-cloud-credentials" (não versionado - ver README.md).

discovery.kubernetes "pods" {
  role = "pod"
}

discovery.relabel "pods" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_node_name"]
    target_label  = "node"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_uid", "__meta_kubernetes_pod_container_name"]
    separator     = "/"
    target_label  = "__path__"
    replacement   = "/var/log/pods/*$1/*.log"
  }
}

local.file_match "pods" {
  path_targets = discovery.relabel.pods.output
}

loki.source.file "pods" {
  targets    = local.file_match.pods.targets
  forward_to = [loki.process.pods.receiver]
}

loki.process "pods" {
  forward_to = [loki.write.grafana_cloud.receiver]

  stage.cri {}

  // Mesma proteção contra "batch poisoning" do ambiente local: descarta
  // entradas mais velhas que o limite de aceitação do Loki para não
  // derrubar o lote inteiro por causa de um log antigo isolado.
  stage.drop {
    older_than = "160h"
  }
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_LOKI_URL")
    basic_auth {
      username = sys.env("GRAFANA_CLOUD_LOKI_USERNAME")
      password = sys.env("GRAFANA_CLOUD_API_KEY")
    }
  }
}

# Recebe traces (e, se algum dia forem instrumentadas, métricas) OTLP dos
# microserviços. Alloy continua sendo o único ponto de entrada de
# telemetria do cluster.
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    metrics = [otelcol.processor.batch.default.input]
    traces  = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    metrics = [otelcol.exporter.prometheus.grafana_cloud.input]
    traces  = [otelcol.exporter.otlphttp.grafana_cloud.input]
  }
}

otelcol.exporter.otlphttp "grafana_cloud" {
  client {
    endpoint = sys.env("GRAFANA_CLOUD_TEMPO_URL")
    auth     = otelcol.auth.basic.grafana_cloud_tempo.handler
  }
}

otelcol.auth.basic "grafana_cloud_tempo" {
  username = sys.env("GRAFANA_CLOUD_TEMPO_USERNAME")
  password = sys.env("GRAFANA_CLOUD_API_KEY")
}

# Nenhum dos 3 serviços emite métricas customizadas hoje (só traces e logs -
# ver CLAUDE.md, seção Observability); este pipeline fica pronto para
# quando/se isso mudar. As métricas RED/service-graph que o Tempo local
# gerava via metrics-generator passam a ser responsabilidade do Tempo
# gerenciado do Grafana Cloud (ver observe-aws/README.md).
otelcol.exporter.prometheus "grafana_cloud" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROMETHEUS_URL")
    basic_auth {
      username = sys.env("GRAFANA_CLOUD_PROMETHEUS_USERNAME")
      password = sys.env("GRAFANA_CLOUD_API_KEY")
    }
  }
}
